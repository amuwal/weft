# Internal-only ops files — must never be deployed to production.
# Vercel ignores .gitignore by default, so we restate them here.
LAUNCH-POSTS.md
launch-day.html

# Source SVGs for OG images (the rendered PNGs ship, sources don't need to)
assets/og-image.svg
assets/og-vs-*.svg
assets/og-blog-*.svg

# Dev artifacts
_head.snippet.html
scripts/
SEO-CHECKLIST.md

# Screenshot-generation tool (Next.js) — build-time dev tool, ~518MB, not part of
# the live site (nothing in the deployed HTML/CSS/JS references it). Excluding it
# keeps the deploy to the ~5MB static site.
screenshot-gen/
